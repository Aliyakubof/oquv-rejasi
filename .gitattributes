# Satr oxirlarini (line endings) Windows va Linux orasida bir xillashtirish
* text=auto eol=lf

# Dasturlash tillari
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

